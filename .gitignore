# Rust
/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local config — not committed (per repo policy on credentials)
~/.terrashift/
.env
.env.local
*.local.toml

# Reference codebases — junctions and large file copies, set up per developer
# via scripts/setup-refs.ps1. Not committed because junctions don't survive
# git and the source archives are large.
/refs/

# Test fixtures — external repos cloned for testing. Not committed because
# some are GPL-2 (incompatible with our Apache-2 distribution) and they bloat
# the repo. Set up via scripts/setup-fixtures.ps1.
/fixtures/

# Audit log working files (user data, never auto-deleted)
.audit/
.checkpoints/
.backup/

# Test artifacts
/coverage/
*.profraw

# Spec Kit feature workdirs
specs/*/output/

# Sandbox executor working directories
/tmp/terrashift-exec-*/

# Security scan artifacts (per session, not for repo)
/checkov-report.json
/checkov-stderr.txt
/package-leakage-report.json
/precommit-scan-*.md
/precommit-scan-*.html

# ────────────────────────────────────────────────────────────────────
# Internal-only documentation (kept on disk, not pushed to GitHub)
# These artifacts drive how the project is built, but they're not
# useful to outside contributors / users. Keep them local.
# ────────────────────────────────────────────────────────────────────

# Internal governance + architecture docs
/CLAUDE.md
/CONSTITUTION.md
/SESSION_PLAN.md
/TERRASHIFT_MAPPING.md
/pre-flight.md
/terrashift_plan.md
/terrashift_prompts.md

# Internal Spec Kit infrastructure + feature specs
/.specify/
/specs/

# Internal docs folder (decisions, drafts, internal references)
/docs/

# Claude Code session-local config
/.claude/settings.local.json
