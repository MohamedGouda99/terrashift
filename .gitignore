# Rust
/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local config — not committed (per Article XIII rule 10)
~/.terrashift/
.env
.env.local
*.local.toml

# Reference codebases — junctions and large file copies, set up per developer
# via scripts/setup-refs.ps1. Not committed because junctions don't survive git
# and stakpak_arch.md is large; see pre-flight.md decision 2.
/refs/

# Audit log working files (per Article IX — user data, never auto-deleted)
.audit/
.checkpoints/
.backup/

# Test artifacts
/coverage/
*.profraw

# Spec Kit feature workdirs
specs/*/output/

# Sandbox executor working directories (per P-09)
/tmp/terrashift-exec-*/

# Security scan artifacts (per session, not for repo)
/checkov-report.json
/checkov-stderr.txt
/package-leakage-report.json
/precommit-scan-*.md
/precommit-scan-*.html
