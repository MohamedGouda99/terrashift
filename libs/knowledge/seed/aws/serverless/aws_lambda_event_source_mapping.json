{
  "name": "aws_lambda_event_source_mapping",
  "description": "Maps an event source to a Lambda function",
  "attributes": {
    "function_name": {
      "name": "function_name",
      "attribute_type": "string",
      "required": true,
      "optional": false,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Name or ARN of the Lambda function"
    },
    "event_source_arn": {
      "name": "event_source_arn",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "ARN of the event source (Kinesis, DynamoDB, SQS, etc.)"
    },
    "batch_size": {
      "name": "batch_size",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Maximum number of records per batch"
    },
    "maximum_batching_window_in_seconds": {
      "name": "maximum_batching_window_in_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Maximum batching window in seconds"
    },
    "enabled": {
      "name": "enabled",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Enable the event source mapping"
    },
    "starting_position": {
      "name": "starting_position",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Starting position for stream-based sources"
    },
    "starting_position_timestamp": {
      "name": "starting_position_timestamp",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Timestamp for AT_TIMESTAMP starting position"
    },
    "parallelization_factor": {
      "name": "parallelization_factor",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Number of batches to process concurrently per shard"
    },
    "maximum_retry_attempts": {
      "name": "maximum_retry_attempts",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Maximum retry attempts for failed records"
    },
    "maximum_record_age_in_seconds": {
      "name": "maximum_record_age_in_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Maximum age of records to process"
    },
    "bisect_batch_on_function_error": {
      "name": "bisect_batch_on_function_error",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Split batch on error for Kinesis/DynamoDB"
    },
    "tumbling_window_in_seconds": {
      "name": "tumbling_window_in_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Tumbling window duration for aggregation"
    },
    "function_response_types": {
      "name": "function_response_types",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Function response types to enable"
    },
    "queues": {
      "name": "queues",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Amazon MQ queue names to consume from"
    },
    "topics": {
      "name": "topics",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Kafka topic names to consume from"
    }
  }
}
