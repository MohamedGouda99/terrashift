{
  "name": "aws_lambda_function",
  "description": "Serverless compute service that runs code in response to events",
  "attributes": {
    "function_name": {
      "name": "function_name",
      "attribute_type": "string",
      "required": true,
      "optional": false,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Unique name for your Lambda function"
    },
    "role": {
      "name": "role",
      "attribute_type": "string",
      "required": true,
      "optional": false,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "IAM role ARN that Lambda assumes when executing"
    },
    "runtime": {
      "name": "runtime",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Runtime environment for the Lambda function"
    },
    "handler": {
      "name": "handler",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Function entrypoint in your code"
    },
    "filename": {
      "name": "filename",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Path to the function deployment package (ZIP file)"
    },
    "s3_bucket": {
      "name": "s3_bucket",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "S3 bucket containing the function deployment package"
    },
    "s3_key": {
      "name": "s3_key",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "S3 key of the function deployment package"
    },
    "s3_object_version": {
      "name": "s3_object_version",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "S3 object version of the deployment package"
    },
    "image_uri": {
      "name": "image_uri",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "ECR image URI for container-based Lambda"
    },
    "package_type": {
      "name": "package_type",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Lambda deployment package type"
    },
    "memory_size": {
      "name": "memory_size",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Amount of memory in MB for the function (128-10240)"
    },
    "timeout": {
      "name": "timeout",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Function execution timeout in seconds (1-900)"
    },
    "architectures": {
      "name": "architectures",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "CPU architecture for the function"
    },
    "description": {
      "name": "description",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Description of the function"
    },
    "publish": {
      "name": "publish",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Publish a new version on each update"
    },
    "reserved_concurrent_executions": {
      "name": "reserved_concurrent_executions",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Reserved concurrent execution limit (-1 to unreserve)"
    },
    "layers": {
      "name": "layers",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "List of Lambda Layer ARNs to attach"
    },
    "kms_key_arn": {
      "name": "kms_key_arn",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "KMS key ARN for encrypting environment variables"
    },
    "source_code_hash": {
      "name": "source_code_hash",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Base64-encoded SHA256 hash of the deployment package"
    },
    "tags": {
      "name": "tags",
      "attribute_type": "map(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Tags to apply to the function"
    }
  }
}
