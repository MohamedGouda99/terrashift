{
  "name": "aws_vpc_endpoint",
  "description": "Enables private connectivity to AWS services without requiring an internet gateway or NAT device",
  "attributes": {
    "vpc_id": {
      "name": "vpc_id",
      "attribute_type": "string",
      "required": true,
      "optional": false,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "VPC in which to create the endpoint"
    },
    "service_name": {
      "name": "service_name",
      "attribute_type": "string",
      "required": true,
      "optional": false,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "AWS service name (e.g., com.amazonaws.us-east-1.s3)"
    },
    "vpc_endpoint_type": {
      "name": "vpc_endpoint_type",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Type of VPC endpoint"
    },
    "auto_accept": {
      "name": "auto_accept",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Accept endpoint connection request automatically"
    },
    "policy": {
      "name": "policy",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Policy to attach to the endpoint (JSON)"
    },
    "private_dns_enabled": {
      "name": "private_dns_enabled",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Enable private DNS for the endpoint (Interface endpoints only)"
    },
    "route_table_ids": {
      "name": "route_table_ids",
      "attribute_type": "set(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Route table IDs (Gateway endpoints only)"
    },
    "subnet_ids": {
      "name": "subnet_ids",
      "attribute_type": "set(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Subnet IDs (Interface and GatewayLoadBalancer endpoints)"
    },
    "security_group_ids": {
      "name": "security_group_ids",
      "attribute_type": "set(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Security group IDs (Interface endpoints only)"
    },
    "ip_address_type": {
      "name": "ip_address_type",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "IP address type for the endpoint"
    },
    "tags": {
      "name": "tags",
      "attribute_type": "map(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Tags to apply to the endpoint"
    }
  }
}
