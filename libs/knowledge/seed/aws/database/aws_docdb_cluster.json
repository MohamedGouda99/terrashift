{
  "name": "aws_docdb_cluster",
  "description": "MongoDB-compatible, fully managed document database service for JSON workloads",
  "attributes": {
    "cluster_identifier": {
      "name": "cluster_identifier",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Unique cluster identifier (auto-generated if omitted)"
    },
    "cluster_identifier_prefix": {
      "name": "cluster_identifier_prefix",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Prefix for auto-generated cluster identifier (conflicts with cluster_identifier)"
    },
    "master_username": {
      "name": "master_username",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Master DB user username (required unless restoring from snapshot, forces new resource)"
    },
    "master_password": {
      "name": "master_password",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Master DB user password (required unless using manage_master_user_password or snapshot)"
    },
    "manage_master_user_password": {
      "name": "manage_master_user_password",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Allow DocumentDB to manage the master password in Secrets Manager"
    },
    "engine": {
      "name": "engine",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Database engine"
    },
    "engine_version": {
      "name": "engine_version",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "DocumentDB engine version"
    },
    "db_subnet_group_name": {
      "name": "db_subnet_group_name",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "DB subnet group to associate with the cluster"
    },
    "vpc_security_group_ids": {
      "name": "vpc_security_group_ids",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "VPC security group IDs to associate"
    },
    "availability_zones": {
      "name": "availability_zones",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "List of AZs where cluster instances can be created"
    },
    "port": {
      "name": "port",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Port on which the DB accepts connections"
    },
    "storage_encrypted": {
      "name": "storage_encrypted",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Enable storage encryption at rest (forces new resource)"
    },
    "kms_key_id": {
      "name": "kms_key_id",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "ARN of KMS key for encryption (requires storage_encrypted=true, forces new resource)"
    },
    "storage_type": {
      "name": "storage_type",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Storage type for the cluster"
    },
    "db_cluster_parameter_group_name": {
      "name": "db_cluster_parameter_group_name",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Cluster parameter group to associate"
    },
    "backup_retention_period": {
      "name": "backup_retention_period",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Days to retain automated backups (1-35)"
    },
    "preferred_backup_window": {
      "name": "preferred_backup_window",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Daily time range for automated backups (hh24:mi-hh24:mi UTC)"
    },
    "preferred_maintenance_window": {
      "name": "preferred_maintenance_window",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Weekly maintenance window (ddd:hh24:mi-ddd:hh24:mi UTC)"
    },
    "deletion_protection": {
      "name": "deletion_protection",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Protect cluster from accidental deletion"
    },
    "skip_final_snapshot": {
      "name": "skip_final_snapshot",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Skip final snapshot before cluster deletion"
    },
    "final_snapshot_identifier": {
      "name": "final_snapshot_identifier",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Name of the final snapshot when deleting the cluster"
    },
    "snapshot_identifier": {
      "name": "snapshot_identifier",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Snapshot ID to restore the cluster from"
    },
    "apply_immediately": {
      "name": "apply_immediately",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Apply modifications immediately instead of during next maintenance window"
    },
    "enabled_cloudwatch_logs_exports": {
      "name": "enabled_cloudwatch_logs_exports",
      "attribute_type": "list(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Log types to export to CloudWatch Logs"
    },
    "allow_major_version_upgrade": {
      "name": "allow_major_version_upgrade",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Allow major engine version upgrades"
    },
    "global_cluster_identifier": {
      "name": "global_cluster_identifier",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Global cluster identifier from aws_docdb_global_cluster"
    },
    "tags": {
      "name": "tags",
      "attribute_type": "map(string)",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Tags to apply to the cluster"
    }
  }
}
