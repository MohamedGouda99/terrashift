    "delay_seconds": {
      "name": "delay_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Delivery delay in seconds (0-900)"
    },
    "receive_wait_time_seconds": {
      "name": "receive_wait_time_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Long polling wait time in seconds (0-20)"
    },
    "policy": {
      "name": "policy",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Access policy document (JSON)"
    },
    "redrive_policy": {
      "name": "redrive_policy",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Dead-letter queue configuration (JSON with deadLetterTargetArn, maxReceiveCount)"
    },
    "redrive_allow_policy": {
      "name": "redrive_allow_policy",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Permissions for dead-letter queue (JSON with redrivePermission, sourceQueueArns)"
    },
