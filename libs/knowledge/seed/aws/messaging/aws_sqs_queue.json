{
  "name": "aws_sqs_queue",
  "description": "Simple Queue Service for reliable, scalable message queuing",
  "attributes": {
    "name": {
      "name": "name",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Name of the queue (conflicts with name_prefix)"
    },
    "name_prefix": {
      "name": "name_prefix",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Prefix for auto-generated name (conflicts with name)"
    },
    "visibility_timeout_seconds": {
      "name": "visibility_timeout_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Visibility timeout in seconds (0-43200)"
    },
    "message_retention_seconds": {
      "name": "message_retention_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Message retention period in seconds (60-1209600)"
    },
    "max_message_size": {
      "name": "max_message_size",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Maximum message size in bytes (1024-262144)"
