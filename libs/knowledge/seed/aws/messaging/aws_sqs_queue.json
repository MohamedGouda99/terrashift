      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Deduplication scope (FIFO only)"
    },
    "fifo_throughput_limit": {
      "name": "fifo_throughput_limit",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "FIFO throughput limit (FIFO only)"
    },
    "kms_master_key_id": {
      "name": "kms_master_key_id",
      "attribute_type": "string",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "KMS key ID for server-side encryption (SSE-KMS)"
    },
    "kms_data_key_reuse_period_seconds": {
      "name": "kms_data_key_reuse_period_seconds",
      "attribute_type": "number",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
