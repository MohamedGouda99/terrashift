      "name": "fifo_queue",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Enable FIFO queue (name must end in .fifo)"
    },
    "content_based_deduplication": {
      "name": "content_based_deduplication",
      "attribute_type": "bool",
      "required": false,
      "optional": true,
      "computed": false,
      "sensitive": false,
      "deprecated": null,
      "description": "Enable content-based deduplication (FIFO only)"
    },
    "deduplication_scope": {
      "name": "deduplication_scope",
