{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7",
  "outputStyle": "explanatory",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(cargo *:*)",
      "Bash(rustc *:*)",
      "Bash(rustup *:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(wc:*)",
      "Bash(find:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Bash(mv:*)"
    ]
  },
  "env": {
    "RUST_BACKTRACE": "1"
  }
}
